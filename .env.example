# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-to-a-long-random-string
PORT=5000

# ─── Firebase Auth (Web API key — different from service account!) ─────────────
# Go to Firebase console → Project Settings → General → "Your apps" → Web API Key
FIREBASE_WEB_API_KEY=AIzaSyDFL69i6KrM1havJ8L4o2x7qU-RXqaMSKo 

# ─── Google Maps (enable Maps JavaScript API on this key) ─────────────────────
# You can reuse GOOGLE_PLACES_API_KEY if Maps JavaScript API is enabled on it
GOOGLE_MAPS_API_KEY=AIzaSyBJv5SBAL9LHdkOjPAcdmSBDeZ_GkPNwx4

# ─── Firebase ─────────────────────────────────────────────────────────────────
# 1. Go to https://console.firebase.google.com → Project Settings → Service Accounts
# 2. Click "Generate new private key" and save the JSON as firebase-key.json
# 3. Set FIREBASE_STORAGE_BUCKET to your project's default bucket
# NOTE: firebase-key.json is gitignored — the server key is never exposed to users.
FIREBASE_KEY_PATH=./firebase-key.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ─── Retell AI (global voice call agent) ──────────────────────────────────────
# Get your API key from https://app.retellai.com → Settings → API Keys
# See retell/SETUP.md for full dashboard configuration steps.
RETELL_API_KEY=
RETELL_API_BASE_URL=https://api.retellai.com

# Global agent (one agent handles ALL listing types via knowledge bases)
RETELL_AGENT_ID=
RETELL_LLM_ID=

# Knowledge base IDs — one per listing category (create in Retell dashboard first)
RETELL_KB_HOMES_ID=
RETELL_KB_EXPERIENCES_ID=
RETELL_KB_PARTIES_ID=

# Signing secret for verifying Retell webhook payloads (from agent settings)
RETELL_WEBHOOK_SECRET=

# ─── Google Places API ────────────────────────────────────────────────────────
# 1. https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create an API key, enable "Places API"
# 3. Restrict to server IP (not HTTP referrer — calls are server-side)
GOOGLE_PLACES_API_KEY=

# ─── Deployment ───────────────────────────────────────────────────────────────
# Public URL of the deployed app — Retell will POST tool calls to this base URL
# e.g. https://air.yourdomain.com   (no trailing slash)
PUBLIC_BASE_URL=https://your-deployed-site.com

# ─── Email (optional) ─────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
