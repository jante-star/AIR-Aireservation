# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-to-a-long-random-string
PORT=5000

# ─── Firebase ─────────────────────────────────────────────────────────────────
# 1. Go to https://console.firebase.google.com → Project Settings → Service Accounts
# 2. Click "Generate new private key" and save the JSON as firebase-key.json
# 3. Set FIREBASE_STORAGE_BUCKET to your project's default bucket (e.g. my-project.appspot.com)
# NOTE: firebase-key.json is gitignored — anyone with access to your deployed
#       site can sign up and use the app; the key stays on the server only.
FIREBASE_KEY_PATH=./firebase-key.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ─── Retell AI (voice call agent) ─────────────────────────────────────────────
# Get your key from https://app.retellai.com → Settings → API Keys
RETELL_API_KEY=
RETELL_API_BASE_URL=https://api.retellai.com

# ─── Google Places API ────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create an API key and enable "Places API" for your project
# 3. For a shared test site: set the key restriction to "None" (unrestricted)
#    OR restrict to "IP addresses" and add your server's public IP.
#    Do NOT restrict to HTTP referrers for a server-side key — calls are made
#    from the backend, not from users' browsers.
GOOGLE_PLACES_API_KEY=

# ─── Email (optional) ─────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
